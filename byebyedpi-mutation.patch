diff -ruN orig/ByeByeDPI-v.1.8.1/app/src/main/java/io/github/romanvht/byedpi/utility/StrategyMutator.kt ByeByeDPI-v.1.8.1/app/src/main/java/io/github/romanvht/byedpi/utility/StrategyMutator.kt
--- a/app/src/main/java/io/github/romanvht/byedpi/utility/StrategyMutator.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/app/src/main/java/io/github/romanvht/byedpi/utility/StrategyMutator.kt	2026-11-08 10:19:04.921813850 +0000
@@ -0,0 +1,171 @@
+package io.github.romanvht.byedpi.utility
+
+import java.util.Random
+import kotlin.math.abs
+
+/**
+ * Produces small random variations of a ByeDPI command line.
+ *
+ * Used by the proxy test: the best strategies found by the normal run are mutated
+ * and the variants are tested against the same sites. This helps when a DPI box
+ * fingerprints the exact parameters of a popular strategy (fixed split offset,
+ * fixed fake TTL, fixed fake SNI).
+ *
+ * Only short options with the well-known syntax are touched (-s -d -o -q -f -r -t -n -Qr),
+ * everything else (auto groups -A/-a, host lists, long options) is preserved as is.
+ * Mutations stay inside conservative ranges so that variants remain valid commands.
+ */
+object StrategyMutator {
+    private const val MAX_ATTEMPTS_FACTOR = 12
+
+    /** Fake SNI candidates; the SNI chosen by the user in the test settings is added on top. */
+    val DEFAULT_SNI_POOL = listOf(
+        "google.com",
+        "yandex.ru",
+        "vk.com",
+        "mail.ru",
+        "ozon.ru",
+        "microsoft.com",
+        "cloudflare.com",
+        // ByeDPI replaces ? # * with a random letter / digit / letter-or-digit for every request
+        "?????.yandex.ru",
+        "*****.vk.com",
+    )
+
+    // -s3 | -d1 | -f-200 | -s3:5+sm | -d2:5:2+h | -r5+s
+    private val positionOption = Regex("""^-([sdoqfr])(-?\d+)((?::\d+){0,2})((?:\+[a-z]+)?)$""")
+    private val ttlOption = Regex("""^-t(\d+)$""")
+
+    fun mutate(
+        command: String,
+        count: Int,
+        sniPool: List<String> = DEFAULT_SNI_POOL,
+        random: Random = Random(),
+    ): List<String> {
+        val base = shellSplit(command)
+        if (base.isEmpty() || count <= 0) return emptyList()
+
+        val baseNormalized = join(base)
+        val baseViolations = orderViolations(base)
+        val result = LinkedHashSet<String>()
+        var attempts = 0
+        while (result.size < count && attempts < count * MAX_ATTEMPTS_FACTOR) {
+            attempts++
+            val tokens = base.toMutableList()
+            val operations = 1 + random.nextInt(2)
+            repeat(operations) { applyRandomOperation(tokens, sniPool, random) }
+            if (orderViolations(tokens) > baseViolations) continue
+            val candidate = join(tokens)
+            if (candidate != baseNormalized) result.add(candidate)
+        }
+        return result.toList()
+    }
+
+    /**
+     * ByeDPI expects positions in ascending order. Counts offsets that go backwards among
+     * options with the same kind (tlsrec vs. the rest), flags and sign inside one auto group.
+     * Some stock strategies already have such cases, so callers compare against the base command.
+     */
+    private fun orderViolations(tokens: List<String>): Int {
+        var violations = 0
+        var last = HashMap<Triple<Boolean, String, Boolean>, Int>()
+        for (token in tokens) {
+            if (token.startsWith("-A")) {
+                last = HashMap()
+                continue
+            }
+            val match = positionOption.matchEntire(token) ?: continue
+            val offset = match.groupValues[2].toIntOrNull() ?: continue
+            val key = Triple(match.groupValues[1] == "r", match.groupValues[4], offset < 0)
+            val previous = last[key]
+            if (previous != null && offset < previous) violations++
+            last[key] = offset
+        }
+        return violations
+    }
+
+    private fun applyRandomOperation(tokens: MutableList<String>, sniPool: List<String>, random: Random) {
+        when (random.nextInt(6)) {
+            0, 1 -> shiftOffset(tokens, random)
+            2 -> changeTtl(tokens, random)
+            3 -> swapSni(tokens, sniPool, random)
+            4 -> toggleFakeRandomization(tokens)
+            5 -> addTlsRecord(tokens, random)
+        }
+    }
+
+    private fun positionIndexes(tokens: List<String>, kinds: String = "sdoqfr"): List<Int> =
+        tokens.indices.filter { i ->
+            positionOption.matchEntire(tokens[i])?.groupValues?.get(1)?.let { kinds.contains(it) } == true
+        }
+
+    private fun hasFake(tokens: List<String>) = positionIndexes(tokens, "f").isNotEmpty()
+
+    /** Moves one split/disorder/oob/fake/tlsrec offset by a few bytes, keeping its sign and flags. */
+    private fun shiftOffset(tokens: MutableList<String>, random: Random) {
+        val indexes = positionIndexes(tokens)
+        if (indexes.isEmpty()) return
+        val i = indexes[random.nextInt(indexes.size)]
+        val match = positionOption.matchEntire(tokens[i]) ?: return
+        val (kind, offsetText, repeats, flags) = match.destructured
+        val offset = offsetText.toIntOrNull() ?: return
+        val magnitude = abs(offset)
+        val maxDelta = (magnitude / 4).coerceIn(2, 10)
+        var delta = 1 + random.nextInt(maxDelta)
+        if (random.nextBoolean()) delta = -delta
+        val newMagnitude = (magnitude + delta).coerceIn(1, 1000)
+        val newOffset = if (offset < 0) -newMagnitude else newMagnitude
+        tokens[i] = "-$kind$newOffset$repeats$flags"
+    }
+
+    /** Changes the TTL of fake packets (only when the strategy uses fake packets). */
+    private fun changeTtl(tokens: MutableList<String>, random: Random) {
+        val i = tokens.indexOfFirst { ttlOption.matches(it) }
+        val newTtl = 3 + random.nextInt(12) // 3..14
+        if (i >= 0) {
+            tokens[i] = "-t$newTtl"
+        } else if (hasFake(tokens)) {
+            tokens.add(0, "-t$newTtl")
+        }
+    }
+
+    /** Picks another fake SNI from the pool (only when the strategy uses fake packets). */
+    private fun swapSni(tokens: MutableList<String>, sniPool: List<String>, random: Random) {
+        if (sniPool.isEmpty()) return
+        val sni = sniPool[random.nextInt(sniPool.size)]
+        val separate = tokens.indexOf("-n")
+        if (separate >= 0 && separate + 1 < tokens.size) {
+            tokens[separate + 1] = sni
+            return
+        }
+        val glued = tokens.indexOfFirst { it.length > 2 && it.startsWith("-n") && it.contains('.') }
+        if (glued >= 0) {
+            tokens[glued] = "-n$sni"
+        } else if (hasFake(tokens)) {
+            tokens.add(0, sni)
+            tokens.add(0, "-n")
+        }
+    }
+
+    /** Toggles random ClientHello fields (SessionID/Random/KeyExchange) in fake packets. */
+    private fun toggleFakeRandomization(tokens: MutableList<String>) {
+        if (!hasFake(tokens)) return
+        val i = tokens.indexOf("-Qr")
+        if (i >= 0) tokens.removeAt(i) else tokens.add(0, "-Qr")
+    }
+
+    /** Adds a TLS record split (combined with TCP segmentation it is harder to reassemble). */
+    private fun addTlsRecord(tokens: MutableList<String>, random: Random) {
+        if (positionIndexes(tokens, "r").isNotEmpty()) return
+        val offset = 1 + random.nextInt(5)
+        tokens.add(0, "-r$offset+s")
+    }
+
+    private fun join(tokens: List<String>): String = tokens.joinToString(" ") { token ->
+        if (token.any { it.isWhitespace() || it == '"' || it == '\'' }) {
+            "\"" + token.replace("\"", "\\\"") + "\""
+        } else {
+            token
+        }
+    }
+}
