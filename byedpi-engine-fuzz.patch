diff -ruN byedpi-orig/desync.c byedpi-main/desync.c
--- a/desync.c	2026-11-08 19:21:20.182291117 +0000
+++ b/desync.c	2026-11-08 19:21:32.682105327 +0000
@@ -466,6 +466,14 @@
     else if (pos < 0 || (flag & OFFSET_END)) {
         pos += n;
     }
+    if (flag & OFFSET_FUZZ) {
+        /* +p flag: randomize the final offset within ±(|pos|/4) but at least ±2.
+           This breaks fixed-offset fingerprints without crossing SNI boundaries. */
+        long fuzz_range = (pos < 0 ? -pos : pos) / 4;
+        if (fuzz_range < 2) fuzz_range = 2;
+        long delta = (long)(rand() % (fuzz_range * 2 + 1)) - fuzz_range;
+        pos += delta;
+    }
     return pos;
 }
 
@@ -521,6 +529,10 @@
         struct eval *val, struct buffer *buff, ssize_t *np, bool *wait)
 {
     struct desync_params dp = *val->pair->dp;
+    /* Randomise TTL per-connection when ttl_range > 0 */
+    if (dp.ttl_range > 0) {
+        dp.ttl = dp.ttl + (rand() % dp.ttl_range);
+    }
     struct proto_info info = { 0 };
     
     int sfd = val->fd;
