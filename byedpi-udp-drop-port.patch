         case 'U':
             params.udp = 0;
             break;
+        case 1000: {
+            /* --udp-drop-port 443,80,... : drop UDP destined to these ports */
+            char *opt = strdup(optarg);
+            if (!opt) { invalid = 1; break; }
+            int cnt = 1;
+            for (char *p = opt; *p; p++) if (*p == ',') cnt++;
+            uint16_t *arr = malloc(cnt * sizeof(uint16_t));
+            if (!arr) { free(opt); invalid = 1; break; }
+            int i = 0;
+            char *tok = strtok(opt, ",");
+            while (tok && i < cnt) {
+                char *end;
+                long v = strtol(tok, &end, 10);
+                if (*end || v < 1 || v > 65535) { invalid = 1; break; }
+                arr[i++] = (uint16_t)v;
+                tok = strtok(NULL, ",");
+            }
+            if (!invalid) {
+                free(params.udp_drop_ports);
+                params.udp_drop_ports = arr;
+                params.udp_drop_ports_n = i;
+            } else { free(arr); }
+            free(opt);
+            break;
+        }
         #ifdef __linux__
